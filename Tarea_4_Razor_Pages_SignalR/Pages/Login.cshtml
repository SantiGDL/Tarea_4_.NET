
@page "/"
@model Tarea_4_Razor_Pages_SignalR.Pages.Login

@{
Layout = null;
}

<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Inicio de sesión</title>

    <!-- Cargo los estilos -->
    <link rel="stylesheet" href="~/css/Estilos.css" />
</head>


<body>

<div class="login-form">

    <h2>Inicio de sesión</h2>

    <form id="loginForm">
        <label for="email">Usuario</label>
        <input type="text" id="email" required />

        <br /><br />

        <label for="password">Contraseña</label>
        <input type="password" id="password" required />

        <br /><br />

        <button type="submit" id="loginButton" disabled>
            Conectando...
        </button>
    </form>

    <div id="verificationMessage" style="display:none;">
        Esperando verificación del usuario...
    </div>

    <div id="enlaceVerificacion" style="display:none;">
        <a id="linkVerificar" href="#" target="_blank"
           rel="noopener noreferrer">
            Verificar usuario
        </a>
    </div>

</div>

<!-- Cargo la biblioteca de SignalR para utilizarla desde JavaScript -->
<script src="~/lib/microsoft/signalr/dist/browser/signalr.js"></script>
<script src="~/js/login.js"></script>

</body>

</html>
